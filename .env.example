# Copier ce fichier en .env sur le serveur et le compléter. Ne jamais le versionner ni le transmettre par message.
# Les clés des services (Stripe, Brevo, Anthropic, stockage, pixels…) peuvent aussi être saisies au back office,
# rubrique « Connexions (API) » : la valeur du back office prime sur celle de ce fichier.

# --- Site ---
DOMAINE=lexpatria.fr
URL_PUBLIQUE=https://lexpatria.fr

# --- Base de données (PostgreSQL) ---
# Base gérée OVHcloud : chaîne de connexion fournie par OVH (avec ?sslmode=require).
DATABASE_URL=
# Option base-locale seulement : mot de passe de la base sur le serveur, et
# DATABASE_URL=postgresql://lexpatria:MOT_DE_PASSE@base:5432/lexpatria
POSTGRES_PASSWORD=

# --- Secrets internes (générer chacun avec : openssl rand -hex 32) ---
SECRET_JETONS=
SECRET_TACHES=
# Chiffre les clés d'API saisies au back office (rubrique Connexions). Ne jamais la changer sans ressaisir les clés.
CLE_CHIFFREMENT=

# --- Stockage des pièces (OVHcloud Object Storage, compatible S3) ---
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=lexpatria-pieces
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Intelligence artificielle (Anthropic, avec non-conservation des données demandée) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_TRIAGE=

# --- Paiement (Stripe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Laisser vide en production : le paiement simulé est alors refusé.
AUTORISER_SIMULATION=

# --- E-mail et SMS (Brevo) ---
BREVO_API_KEY=
EMAIL_EXPEDITEUR=

# --- Mesure d'audience (chargée seulement après accord du visiteur, sauf Matomo sans cookie) ---
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# --- Divers ---
NEXT_PUBLIC_TELEPHONE_CABINET=
